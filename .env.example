# Identifiants de votre application France Travail (API Offres d'emploi v2).
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE="api_offresdemploiv2 o2dsoffre"

# Chemins relatifs au dossier jobhunter-ai, ou chemins absolus.
CV_PATH="cv/mon_cv.pdf"
DATABASE_PATH="data/jobhunter.db"
HTTP_TIMEOUT=20

# local (sans clé), mistral, openai ou auto. Le mode local reste le fallback.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=
# Exemple Mistral : LLM_PROVIDER=mistral, LLM_MODEL=ministral-8b-latest
# Exemple OpenAI : LLM_PROVIDER=openai, LLM_MODEL=gpt-4o-mini
# auto : LLM_MODEL=mistral/ministral-8b-latest ou openai/gpt-4o-mini
# Une seule clé/fournisseur actif à la fois. Clé uniquement dans ce fichier .env.
# HTTP_TIMEOUT ci-dessus limite l'attente réseau (plafonnée à 60 s pour le LLM).

# Gmail : OAuth Google « Application de bureau », uniquement des brouillons.
GMAIL_CLIENT_SECRET_FILE="secrets/client_secret.json"
GMAIL_TOKEN_FILE="tokens/gmail_token.json"

# Même application FT : activer séparément La Bonne Boîte v2, scope api_labonneboitev2.
# Facultatif : session Chromium existante avec CDP local, jamais un mot de passe.
# Sans CDP, Envoyer ouvre simplement le navigateur habituel.
BROWSER_CDP_URL=
