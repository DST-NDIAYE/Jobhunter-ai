# Identifiants de votre application France Travail (API Offres d'emploi v2 ; candidatures spontanées : ajoutez
# aussi l'API « La Bonne Boîte v2 » à la même application sur francetravail.io, le scope est demandé par le code).
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE="api_offresdemploiv2 o2dsoffre"

# Chemins relatifs au dossier jobhunter-ai, ou chemins absolus. Le CV vient de cv_master.yaml.
DATABASE_PATH="data/jobhunter.db"
HTTP_TIMEOUT=60

# local (sans clé), gemini, mistral, openai, groq ou auto. Sans modèle configuré, CV et lettre sont indisponibles.
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=
# LLM_MODEL sert à l'analyse de l'offre et à l'ordre du CV (un modèle « lite » suffit).
# Modèle de secours (même fournisseur) : après 3 essais en surcharge (503), dès un quota atteint (429),
# ou après un autre échec.
LLM_FALLBACK_MODEL=
# Lettre de motivation : modèle dédié (par défaut LLM_MODEL), jamais un modèle « lite ».
LETTER_MODEL=
LETTER_FALLBACK_MODEL=
# Exemple Mistral : LLM_PROVIDER=mistral, LLM_MODEL=ministral-8b-latest
# Exemple OpenAI : LLM_PROVIDER=openai, LLM_MODEL=gpt-4o-mini
# auto : LLM_MODEL=mistral/ministral-8b-latest ou openai/gpt-4o-mini
# Une seule clé/fournisseur actif à la fois. Clé uniquement dans ce fichier .env.
# HTTP_TIMEOUT ci-dessus limite l'attente réseau (plafonnée à 60 s pour le LLM).

# Gmail : seul l'état (configuré ou non) est affiché ; l'application n'envoie rien et ne crée aucun brouillon.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_TOKEN_FILE="tokens/gmail_token.json"
